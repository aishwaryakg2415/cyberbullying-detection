# SACENet needs NO secrets or API keys. All variables below are optional.

# Use only locally cached, revision-pinned model weights (set automatically by the scripts).
HF_HUB_OFFLINE=1

# Optional Hugging Face token: only raises download rate limits for scripts/download_models.py.
# HF_TOKEN=

# Force a device for the demo app: auto | cuda | mps | cpu
SACENET_DEVICE=auto

# Override checkpoint locations used by the demo app.
# SACENET_CB_MODEL=results/runs/mc7__muril__base__s13/checkpoint/model
# SACENET_SARC_MODEL=results/runs/sarcasm__muril__base__s13/checkpoint/model
